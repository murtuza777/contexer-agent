# Contexer Configuration Example
# Copy this file to .env and configure your keys.

# OpenRouter API Key (Required for LLM features)
# Obtain from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Model Name (Defaults to openrouter/free)
# openrouter/free picks a different free model per request, and some of them
# (e.g. safety classifiers) ignore structured-output instructions. Contexer
# retries once, but pin a specific instruction-following model for reliable runs.
OPENROUTER_MODEL=openrouter/free

# Optional OpenRouter attribution headers
OPENROUTER_SITE_URL=https://github.com/contexer/contexer
OPENROUTER_APP_NAME=Contexer

# Logging & Output
LOG_LEVEL=INFO
VERBOSE=false

# GitHub Integration (Official GitHub MCP Server)
# Create a Personal Access Token with repo (read) scope at https://github.com/settings/tokens
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_pat_here
# Optional: toolsets (defaults to repos,issues)
# GITHUB_TOOLSETS=repos,issues
# Optional: force read-only (defaults to true)
# GITHUB_READ_ONLY=true

