# Contexer Configuration Example
# Copy this file to .env and configure your keys.
#
# A model is needed only to DRAFT checks from a goal (`contract draft`,
# `verify "<goal>"`, `run "<goal>"`). Replaying approved contracts never calls
# a model. Set any ONE of the keys below; when several are set, Contexer uses
# Anthropic, then OpenAI, then OpenRouter, unless CONTEXER_LLM_PROVIDER or
# [compiler] in contexer.toml says otherwise. Draft quality depends heavily on
# the model: see bench/RESULTS.md.

# Anthropic (https://console.anthropic.com/settings/keys)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-opus-5-5

# OpenAI, or any OpenAI-compatible gateway via OPENAI_BASE_URL
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-5
# OPENAI_BASE_URL=https://api.openai.com/v1

# Force a provider for drafting: anthropic | openai | openrouter
# CONTEXER_LLM_PROVIDER=anthropic

# OpenRouter API Key (also used by the interactive shell's chat agent)
# Obtain from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Model Name (Defaults to openrouter/free)
# openrouter/free picks a different free model per request, and some of them
# (e.g. safety classifiers) ignore structured-output instructions. Contexer
# retries once, but pin a specific instruction-following model for reliable runs.
OPENROUTER_MODEL=openrouter/free

# Optional OpenRouter attribution headers
OPENROUTER_SITE_URL=https://github.com/contexer/contexer
OPENROUTER_APP_NAME=Contexer

# Logging & Output
LOG_LEVEL=INFO
VERBOSE=false

# GitHub Integration (Official GitHub MCP Server)
# Create a Personal Access Token with repo (read) scope at https://github.com/settings/tokens
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_pat_here
# Optional: toolsets (defaults to repos,issues)
# GITHUB_TOOLSETS=repos,issues
# Optional: force read-only (defaults to true)
# GITHUB_READ_ONLY=true

